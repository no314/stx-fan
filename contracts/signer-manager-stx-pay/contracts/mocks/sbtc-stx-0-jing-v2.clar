;; Mock of SPV9K21TBFAK4KNRJXF5DFP8N7W46G4V9RCJDC22.sbtc-stx-0-jing-v2 (read 2026-09-20).
;; Reproduces the sBTC-seller side of the batch auction: deposit with limit,
;; close, settle at a test-supplied price with pro-rata fill, limit and
;; small-share rolls, fee 10 bps, remainder rollover, cancel, bump-out.
;; The STX side is a single test-controlled buyer (`mock-buy`).
(define-constant DEPOSIT_MIN_BLOCKS u10)
(define-constant PHASE_DEPOSIT u0)
(define-constant PHASE_SETTLE u2)
(define-constant FEE_BPS u10)
(define-constant BPS_PRECISION u10000)
(define-constant MIN_SHARE_BPS u20)
(define-constant PRICE_PRECISION u100000000)
(define-constant DECIMAL_FACTOR u100)
(define-constant ERR_DEPOSIT_TOO_SMALL (err u1001))
(define-constant ERR_NOT_DEPOSIT_PHASE (err u1002))
(define-constant ERR_NOT_SETTLE_PHASE (err u1003))
(define-constant ERR_NOTHING_TO_WITHDRAW (err u1008))
(define-constant ERR_PAUSED (err u1010))
(define-constant ERR_NOTHING_TO_SETTLE (err u1012))
(define-constant ERR_LIMIT_REQUIRED (err u1017))

(define-data-var paused bool false)
(define-data-var current-cycle uint u15)
(define-data-var deposits-closed-block uint u0)
(define-data-var min-sbtc-deposit uint u1000)
(define-data-var treasury principal tx-sender)
(define-map sbtc-deposits {cycle: uint, depositor: principal} uint)
(define-map sbtc-deposit-limits principal uint)
(define-map sbtc-depositor-list uint (list 50 principal))
(define-map cycle-totals uint {total-stx: uint, total-sbtc: uint})
(define-map settlements uint {price: uint, stx-cleared: uint, sbtc-cleared: uint, stx-fee: uint, sbtc-fee: uint, settled-at: uint})
;; settlement scratch
(define-data-var s-price uint u0)
(define-data-var s-total-sbtc uint u0)
(define-data-var s-sbtc-cleared uint u0)
(define-data-var s-stx-after-fee uint u0)
(define-data-var bumped principal tx-sender)

;; ---- real read-only surface
(define-read-only (get-current-cycle) (var-get current-cycle))
(define-read-only (get-cycle-phase) (if (is-eq (var-get deposits-closed-block) u0) PHASE_DEPOSIT PHASE_SETTLE))
(define-read-only (get-cycle-totals (cycle uint)) (default-to {total-stx: u0, total-sbtc: u0} (map-get? cycle-totals cycle)))
(define-read-only (get-settlement (cycle uint)) (map-get? settlements cycle))
(define-read-only (get-sbtc-deposit (cycle uint) (depositor principal)) (default-to u0 (map-get? sbtc-deposits {cycle: cycle, depositor: depositor})))
(define-read-only (get-sbtc-limit (depositor principal)) (default-to u0 (map-get? sbtc-deposit-limits depositor)))
(define-read-only (get-sbtc-depositors (cycle uint)) (default-to (list) (map-get? sbtc-depositor-list cycle)))

;; ---- real public surface (seller side)
(define-public (deposit-sbtc (amount uint) (limit-price uint))
  (let ((cycle (var-get current-cycle)) (existing (get-sbtc-deposit cycle tx-sender)) (totals (get-cycle-totals cycle)))
    (asserts! (not (var-get paused)) ERR_PAUSED)
    (asserts! (is-eq (get-cycle-phase) PHASE_DEPOSIT) ERR_NOT_DEPOSIT_PHASE)
    (asserts! (>= amount (var-get min-sbtc-deposit)) ERR_DEPOSIT_TOO_SMALL)
    (asserts! (> limit-price u0) ERR_LIMIT_REQUIRED)
    (try! (contract-call? .sbtc-token transfer amount tx-sender current-contract none))
    (map-set sbtc-deposits {cycle: cycle, depositor: tx-sender} (+ existing amount))
    (map-set sbtc-deposit-limits tx-sender limit-price)
    (map-set cycle-totals cycle (merge totals {total-sbtc: (+ (get total-sbtc totals) amount)}))
    (if (is-eq existing u0)
      (map-set sbtc-depositor-list cycle (unwrap-panic (as-max-len? (append (get-sbtc-depositors cycle) tx-sender) u50)))
      true)
    (ok amount)))

(define-public (cancel-sbtc-deposit)
  (let ((cycle (var-get current-cycle)) (caller tx-sender) (amount (get-sbtc-deposit cycle caller)) (totals (get-cycle-totals cycle)))
    (asserts! (is-eq (get-cycle-phase) PHASE_DEPOSIT) ERR_NOT_DEPOSIT_PHASE)
    (asserts! (> amount u0) ERR_NOTHING_TO_WITHDRAW)
    (try! (as-contract? ((with-ft .sbtc-token "sbtc-token" amount))
      (try! (contract-call? .sbtc-token transfer amount current-contract caller none))))
    (map-delete sbtc-deposits {cycle: cycle, depositor: caller})
    (map-delete sbtc-deposit-limits caller)
    (var-set bumped caller)
    (map-set sbtc-depositor-list cycle (filter not-bumped (get-sbtc-depositors cycle)))
    (map-set cycle-totals cycle (merge totals {total-sbtc: (- (get total-sbtc totals) amount)}))
    (ok amount)))

(define-public (set-sbtc-limit (limit-price uint))
  (begin
    (asserts! (is-eq (get-cycle-phase) PHASE_DEPOSIT) ERR_NOT_DEPOSIT_PHASE)
    (asserts! (> limit-price u0) ERR_LIMIT_REQUIRED)
    (asserts! (> (get-sbtc-deposit (var-get current-cycle) tx-sender) u0) ERR_NOTHING_TO_WITHDRAW)
    (map-set sbtc-deposit-limits tx-sender limit-price)
    (ok true)))

(define-private (not-bumped (p principal)) (not (is-eq p (var-get bumped))))

;; ---- test controls
;; The STX side: the test supplies `stx` uSTX to this cycle (transferred in).
(define-public (mock-buy (stx uint))
  (let ((cycle (var-get current-cycle)) (totals (get-cycle-totals cycle)))
    (asserts! (is-eq (get-cycle-phase) PHASE_DEPOSIT) ERR_NOT_DEPOSIT_PHASE)
    (try! (stx-transfer? stx tx-sender current-contract))
    (ok (map-set cycle-totals cycle (merge totals {total-stx: (+ (get total-stx totals) stx)})))))
(define-public (mock-set-paused (p bool)) (begin (asserts! true (err u1)) (ok (var-set paused p))))
;; Displace a seller as a larger deposit would: refund and delete.
(define-public (mock-bump (depositor principal))
  (let ((cycle (var-get current-cycle)) (amount (get-sbtc-deposit cycle depositor)) (totals (get-cycle-totals cycle)))
    (asserts! (> amount u0) ERR_NOTHING_TO_WITHDRAW)
    (try! (as-contract? ((with-ft .sbtc-token "sbtc-token" amount))
      (try! (contract-call? .sbtc-token transfer amount current-contract depositor none))))
    (map-delete sbtc-deposits {cycle: cycle, depositor: depositor})
    (map-delete sbtc-deposit-limits depositor)
    (var-set bumped depositor)
    (map-set sbtc-depositor-list cycle (filter not-bumped (get-sbtc-depositors cycle)))
    (ok (map-set cycle-totals cycle (merge totals {total-sbtc: (- (get total-sbtc totals) amount)})))))
(define-public (close-deposits)
  (begin
    (asserts! (is-eq (get-cycle-phase) PHASE_DEPOSIT) ERR_NOT_DEPOSIT_PHASE)
    (map filter-small (get-sbtc-depositors (var-get current-cycle)))
    (var-set deposits-closed-block stacks-block-height)
    (ok true)))
;; Cancel the cycle: roll every deposit forward unchanged, no settlement.
(define-public (mock-cancel-cycle)
  (let ((cycle (var-get current-cycle)))
    (asserts! (not (is-eq (var-get deposits-closed-block) u0)) ERR_NOT_SETTLE_PHASE)
    (map-set cycle-totals (+ cycle u1) (get-cycle-totals cycle))
    (map roll-depositor (get-sbtc-depositors cycle))
    (map-set sbtc-depositor-list (+ cycle u1) (get-sbtc-depositors cycle))
    (map-delete sbtc-depositor-list cycle)
    (var-set current-cycle (+ cycle u1))
    (var-set deposits-closed-block u0)
    (ok true)))
(define-private (roll-depositor (d principal))
  (let ((cycle (var-get current-cycle)))
    (map-set sbtc-deposits {cycle: (+ cycle u1), depositor: d} (get-sbtc-deposit cycle d))
    (map-delete sbtc-deposits {cycle: cycle, depositor: d})))

;; Settle at `price` (STX per BTC times 1e8), following execute-settlement +
;; distribute-to-sbtc-depositor + roll-and-sweep-dust for the sBTC side.
(define-public (mock-settle (price uint))
  (let ((cycle (var-get current-cycle)))
    (asserts! (is-eq (get-cycle-phase) PHASE_SETTLE) ERR_NOT_SETTLE_PHASE)
    (var-set s-price price)
    (map filter-limit (get-sbtc-depositors cycle))
    (let ((totals (get-cycle-totals cycle))
          (total-stx (get total-stx totals)) (total-sbtc (get total-sbtc totals))
          (stx-value-of-sbtc (/ (* total-sbtc price) (* PRICE_PRECISION DECIMAL_FACTOR)))
          (sbtc-is-binding (<= stx-value-of-sbtc total-stx))
          (stx-clearing (if sbtc-is-binding stx-value-of-sbtc total-stx))
          (sbtc-clearing (if sbtc-is-binding total-sbtc (/ (* total-stx (* PRICE_PRECISION DECIMAL_FACTOR)) price)))
          (stx-fee (/ (* stx-clearing FEE_BPS) BPS_PRECISION))
          (sbtc-fee (/ (* sbtc-clearing FEE_BPS) BPS_PRECISION)))
      (asserts! (and (> total-stx u0) (>= total-sbtc (var-get min-sbtc-deposit))) ERR_NOTHING_TO_SETTLE)
      (map-set settlements cycle {price: price, stx-cleared: stx-clearing, sbtc-cleared: sbtc-clearing, stx-fee: stx-fee, sbtc-fee: sbtc-fee, settled-at: stacks-block-height})
      (var-set s-total-sbtc total-sbtc)
      (var-set s-sbtc-cleared sbtc-clearing)
      (var-set s-stx-after-fee (- stx-clearing stx-fee))
      (map distribute (get-sbtc-depositors cycle))
      (map-delete sbtc-depositor-list cycle)
      (var-set current-cycle (+ cycle u1))
      (var-set deposits-closed-block u0)
      (print {event: "settlement", cycle: cycle, price: price, sbtc-cleared: sbtc-clearing, stx-cleared: stx-clearing, binding-side: (if sbtc-is-binding "sbtc" "stx")})
      (ok true))))

(define-private (filter-small (d principal))
  (let ((cycle (var-get current-cycle)) (totals (get-cycle-totals cycle)) (amount (get-sbtc-deposit cycle d)))
    (if (< (* amount BPS_PRECISION) (* (get total-sbtc totals) MIN_SHARE_BPS))
      (roll-one d amount cycle totals) true)))
(define-private (filter-limit (d principal))
  (let ((cycle (var-get current-cycle)) (totals (get-cycle-totals cycle)) (amount (get-sbtc-deposit cycle d)))
    (if (< (var-get s-price) (get-sbtc-limit d))
      (roll-one d amount cycle totals) true)))
(define-private (roll-one (d principal) (amount uint) (cycle uint) (totals {total-stx: uint, total-sbtc: uint}))
  (let ((next (+ cycle u1)) (tn (get-cycle-totals next)))
    (map-set sbtc-deposits {cycle: next, depositor: d} amount)
    (map-set sbtc-depositor-list next (unwrap-panic (as-max-len? (append (get-sbtc-depositors next) d) u50)))
    (map-set cycle-totals next (merge tn {total-sbtc: (+ (get total-sbtc tn) amount)}))
    (map-delete sbtc-deposits {cycle: cycle, depositor: d})
    (var-set bumped d)
    (map-set sbtc-depositor-list cycle (filter not-bumped (get-sbtc-depositors cycle)))
    (map-set cycle-totals cycle (merge totals {total-sbtc: (- (get total-sbtc totals) amount)}))
    true))
(define-private (pay-stx (amount uint) (to principal))
  (as-contract? ((with-stx amount)) (try! (stx-transfer? amount tx-sender to))))
(define-private (distribute (d principal))
  (let ((cycle (var-get current-cycle)) (my (get-sbtc-deposit cycle d)) (total (var-get s-total-sbtc))
        (my-stx (if (> total u0) (/ (* my (var-get s-stx-after-fee)) total) u0))
        (my-unfilled (if (> total u0) (/ (* my (- total (var-get s-sbtc-cleared))) total) u0))
        (next (+ cycle u1)) (tn (get-cycle-totals next)))
    (map-delete sbtc-deposits {cycle: cycle, depositor: d})
    (if (> my-stx u0)
      (unwrap-panic (pay-stx my-stx d))
      true)
    (if (> my-unfilled u0)
      (begin
        (map-set sbtc-deposits {cycle: next, depositor: d} my-unfilled)
        (map-set sbtc-depositor-list next (unwrap-panic (as-max-len? (append (get-sbtc-depositors next) d) u50)))
        (map-set cycle-totals next (merge tn {total-sbtc: (+ (get total-sbtc tn) my-unfilled)}))
        true)
      (begin (map-delete sbtc-deposit-limits d) true))
    (print {event: "distribute-sbtc-depositor", depositor: d, cycle: cycle, stx-received: my-stx, sbtc-rolled: my-unfilled})
    true))
